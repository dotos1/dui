    {
      "name": "PerfectScrollbarDirective",
      "kind": "directive",
      "selector": "[perfectScrollbar]",
      "summary": "Wraps the `perfect-scrollbar` library on the host element, providing custom scrollbars\nand scroll event outputs (`psScrollY`, `psYReachEnd`, etc.).",
      "summaryZh": "在宿主元素上封装 `perfect-scrollbar` 库，提供自定义滚动条以及滚动事件输出\n（`psScrollY`、`psYReachEnd` 等）。",
      "sourceFile": "src/common/perfect-scrollbar/perfect-scrollbar.directive.ts",
      "inputs": [
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "description": null,
          "descriptionZh": "是否禁用自定义滚动条（禁用后销毁底层 Perfect Scrollbar 实例）。"
        },
        {
          "name": "config",
          "alias": "perfectScrollbar",
          "type": "PerfectScrollbarConfigInterface",
          "description": null,
          "descriptionZh": "传给底层 Perfect Scrollbar 实例的配置项。"
        }
      ],
      "outputs": [
        {
          "name": "psScrollY",
          "type": "any",
          "description": null,
          "descriptionZh": "垂直滚动时发出。"
        },
        {
          "name": "psScrollX",
          "type": "any",
          "description": null,
          "descriptionZh": "水平滚动时发出。"
        },
        {
          "name": "psScrollUp",
          "type": "any",
          "description": null,
          "descriptionZh": "向上滚动时发出。"
        },
        {
          "name": "psScrollDown",
          "type": "any",
          "description": null,
          "descriptionZh": "向下滚动时发出。"
        },
        {
          "name": "psScrollLeft",
          "type": "any",
          "description": null,
          "descriptionZh": "向左滚动时发出。"
        },
        {
          "name": "psScrollRight",
          "type": "any",
          "description": null,
          "descriptionZh": "向右滚动时发出。"
        },
        {
          "name": "psYReachEnd",
          "type": "any",
          "description": null,
          "descriptionZh": "垂直方向滚动到底部时发出。"
        },
        {
          "name": "psYReachStart",
          "type": "any",
          "description": null,
          "descriptionZh": "垂直方向滚动到顶部时发出。"
        },
        {
          "name": "psXReachEnd",
          "type": "any",
          "description": null,
          "descriptionZh": "水平方向滚动到右侧末端时发出。"
        },
        {
          "name": "psXReachStart",
          "type": "any",
          "description": null,
          "descriptionZh": "水平方向滚动到左侧起始位置时发出。"
        }
      ],
      "methods": [
        {
          "name": "ps",
          "params": [],
          "returnType": "PerfectScrollbar | null",
          "description": "Returns the underlying `perfect-scrollbar` library instance, or `null` if not initialized.",
          "descriptionZh": "返回底层 `perfect-scrollbar` 库实例，未初始化时返回 `null`。"
        },
        {
          "name": "update",
          "params": [],
          "returnType": "void",
          "description": "Recalculates the scrollbar geometry (debounced); call after content size changes.",
          "descriptionZh": "重新计算滚动条几何信息（带防抖）；在内容尺寸变化后调用。"
        },
        {
          "name": "geometry",
          "params": [
            {
              "name": "prefix",
              "type": "string"
            }
          ],
          "returnType": "Geometry",
          "description": "Returns the host element's current scroll position/size as a {@link Geometry}, using the\ngiven DOM property prefix (`scroll`/`offset`/`client`).",
          "descriptionZh": "使用给定的 DOM 属性前缀（`scroll`/`offset`/`client`），\n以 {@link Geometry} 形式返回宿主元素当前的滚动位置/尺寸。"
        },
        {
          "name": "position",
          "params": [
            {
              "name": "absolute",
              "type": "boolean"
            }
          ],
          "returnType": "Position",
          "description": "Returns the current scroll position, either relative to the scrollbar's \"reach\" state\nor absolute (native `scrollLeft`/`scrollTop`) if `absolute` is `true`.",
          "descriptionZh": "返回当前滚动位置；默认相对于滚动条的\"到达边缘\"状态，`absolute` 为 `true` 时\n返回绝对位置（原生 `scrollLeft`/`scrollTop`）。"
        },
        {
          "name": "scrollable",
          "params": [
            {
              "name": "direction",
              "type": "string"
            }
          ],
          "returnType": "boolean",
          "description": "Whether the host element is currently scrollable in the given direction\n(`'any'`, `'both'`, `'x'`, or `'y'`).",
          "descriptionZh": "宿主元素当前在给定方向上是否可滚动（`'any'`、`'both'`、`'x'` 或 `'y'`）。"
        },
