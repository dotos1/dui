        },
        {
          "name": "externalContentWrapper",
          "type": "InputSignal<string>",
          "default": "input<string>()",
          "description": "Selector used to query the content wrapper element."
        },
        {
          "name": "externalSpacer",
          "type": "InputSignal<string>",
          "default": "input<string>()",
          "description": "Selector used to query the spacer element (virtual scroll integration).\nIn the case of integrating the scrollbar with a virtual scroll component,\na spacer element is typically created to match the real size of the content.\nThe scrollbar will use the size of this spacer element for calculations instead of the content wrapper size."
        },
        {
          "name": "altViewport",
          "type": "WritableSignal<HTMLElement>",
          "default": "signal<HTMLElement>(null)",
          "description": null
        },
        {
          "name": "altContentWrapper",
          "type": "WritableSignal<HTMLElement>",
          "default": "signal<HTMLElement>(null)",
          "description": null
        },
        {
          "name": "altSpacer",
          "type": "WritableSignal<HTMLElement>",
          "default": "signal<HTMLElement>(null)",
          "description": null
        },
        {
          "name": "viewportElement",
          "type": "Signal<HTMLElement>",
          "default": "computed(() => {\n    if (this.customViewport()) {\n      return this.customViewport().nativeElement;\n    }\n    if (this.altViewport()) {\n      return this.altViewport();\n    }\n    // If viewport selector was defined, query the element\n    const selector: string = this.externalViewport();\n    return selector ? this.nativeElement.querySelector(selector) : null;\n  })",
          "description": null
        },
        {
          "name": "viewportError",
          "type": "Signal<string>",
          "default": "computed(() => {\n    return !this.viewportElement()\n      ? `[NgScrollbar]: Could not find the viewport element for the provided selector \"${ this.externalViewport() }\"`\n      : null;\n  })",
          "description": null
        },
        {
          "name": "contentWrapperElement",
          "type": "Signal<HTMLElement>",
          "default": "computed(() => {\n    if (this.altContentWrapper()) {\n      return this.altContentWrapper();\n    }\n    const selector: string = this.externalContentWrapper();\n    return selector ? this.nativeElement.querySelector(selector) : null;\n  })",
          "description": null
        },
        {
          "name": "contentWrapperError",
          "type": "Signal<string>",
          "default": "computed(() => {\n    return !this.contentWrapperElement() && this.externalContentWrapper()\n      ? `[NgScrollbar]: Content wrapper element not found for the provided selector \"${ this.externalContentWrapper() }\"`\n      : null;\n  })",
          "description": null
        },
        {
          "name": "spacerElement",
          "type": "Signal<HTMLElement>",
          "default": "computed(() => {\n    if (this.altSpacer()) {\n      return this.altSpacer();\n    }\n    const selector: string = this.externalSpacer();\n    return selector ? this.nativeElement.querySelector(selector) : null\n  })",
          "description": null
        },
        {
          "name": "spacerError",
          "type": "Signal<string>",
          "default": "computed(() => {\n    return !this.spacerElement() && this.externalSpacer()\n      ? `[NgScrollbar]: Spacer element not found for the provided selector \"${ this.externalSpacer() }\"`\n      : null;\n  })",
          "description": null
        },
        {
          "name": "customViewport",
          "type": "Signal<ScrollViewport>",
          "default": "contentChild(ScrollViewport, { descendants: true })",
          "description": "Reference to the external viewport directive if used"
        }
      ]
