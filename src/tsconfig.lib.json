{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/lib",
    "declarationMap": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "types": [],
    "resolveJsonModule": true,
    "useDefineForClassFields": false
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build/**/*",
    "jest.config.ts",
    "**/*.spec.ts"
  ],
  "angularCompilerOptions": {
    "compilationMode": "partial"
  }
}
