{
  "name": "dui",
  "version": "7.2.45",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "watch-dui": "ng build dui  --configuration production --watch",
    "build-dui": "ng build dui --configuration production",
    "prebuild": "npm --no-git-tag-version version patch && cd src  && npm --no-git-tag-version version patch",
    "npm_pack": "cd dist/dui && npm pack",
    "package": "npm run prebuild && npm run build-dui && npm run npm_pack",
    "publish": "cd dist/dui && npm publish  --ignore-scripts",
    "unpublish": "cd dist/dui && npm unpublish @dotos/dui@latest  --force"
  },
  "dependencies": {
    "@angular/animations": "18.2.13",
