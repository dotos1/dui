{
  "name": "dui",
  "version": "8.0.0-next.2",
  "license": "UNLICENSED",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "watch-dui": "ng build dui  --configuration production --watch",
    "build-dui": "ng build dui --configuration production",
    "docs:generate": "tsc -p projects/testdui/tools/tsconfig.tools.json && node projects/testdui/tools/.dist-tools/generate-api-docs.js",
    "gate:any": "node gates/any-count.js --check",
    "gate:any:list": "node gates/any-count.js --list",
    "gate:any:freeze": "node gates/any-count.js --freeze",
    "gate:any:selftest": "node gates/any-count.js --selftest",
    "gate:any:sites": "node gates/any-count.js --sites",
    "gate:tsc": "node gates/tsc-check.js",
    "gate:i18n": "node gates/i18n-check.js --selftest && node gates/i18n-check.js",
    "docs:sync-types": "node tools/jsdoc-sync-types.js && node tools/jsdoc-zh-phrasing.js",
    "gate:jsdoc": "node tools/jsdoc-sync-types.js --check && node tools/jsdoc-zh-phrasing.js --check",
    "gate:esm": "node gates/esm-import-check.js --selftest && node gates/esm-import-check.js",
    "gate:ng22-compat": "node tools/ng-upgrade/ng22-compat-gate.mjs",
    "gate:style-ref": "node tools/ng-upgrade/style-ref-gate.mjs",
    "prebuild": "npm --no-git-tag-version version patch && cd src  && npm --no-git-tag-version version patch",
    "npm_pack": "cd dist/dui && npm pack",
    "package": "npm run prebuild && npm run build-dui && npm run npm_pack",
    "publish": "cd dist/dui && rm -f *.tgz && npm publish  --ignore-scripts",
    "unpublish": "cd dist/dui && npm unpublish @dotos/dui@latest  --force",
    "gate:standalone": "node tools/ng-upgrade/ensure-standalone-false.mjs --check",
    "test:jest": "jest --runInBand",
    "generate:m2-tokens": "node tools/m2-parity/generate-m2-tokens.mjs",
    "test:m2-theme": "jest --runInBand src/theme/theme.service.spec.ts",
    "parity:m2": "node tools/m2-parity/run-m2-parity.mjs"
  },
  "dependencies": {
    "@angular/animations": "22.2.6",
    "@angular/cdk": "22.2.7",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/material": "22.2.7",
    "@angular/material-moment-adapter": "22.2.7",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "buffer": "^6.0.3",
    "@floating-ui/core": "^1.6.9",
    "@floating-ui/dom": "^1.6.13",
    "@juggle/resize-observer": "^3.4.0",
    "@svgdotjs/svg.js": "^3.2.5",
    "colornames": "^1.1.1",
    "core-js": "^3.21.1",
    "dayjs": "^1.11.20",
    "depcheck": "^1.4.7",
    "element-resize-detector": "^1.2.4",
    "fuse.js": "^6.6.2",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "lodash-es": "^4.17.21",
    "material-icons": "^1.13.12",
    "minimatch-browser": "^1.0.0",
    "mobx": "^6.13.7",
    "moment": "^2.29.1",
    "monaco-editor": "0.50.0",
    "monaco-editor-nls": "^3.1.0",
    "monaco-editor-webpack-plugin": "^7.1.0",
    "monaco-vim": "^0.4.1",
    "ngx-flexible-layout": "^22.0.0",
    "perfect-scrollbar": "^1.5.5",
    "prosemirror-commands": "^1.3.1",
    "prosemirror-history": "^1.3.0",
    "prosemirror-inputrules": "^1.2.0",
    "prosemirror-keymap": "^1.2.0",
    "prosemirror-model": "^1.18.1",
    "prosemirror-schema-list": "^1.2.2",
    "prosemirror-state": "^1.4.2",
    "resize-observer-polyfill": "^1.5.1",
    "rxjs": "~7.8.1",
    "showdown": "^2.1.0",
    "tinycolor2": "^1.6.0",
    "tslib": "^2.3.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zone.js": "~0.15.1",
    "@angular/aria": "22.2.7"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@types/jasmine": "5.1.4",
    "@types/lodash-es": "4.17.12",
    "jasmine-core": "5.1.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-preset-angular": "17.0.3",
    "karma": "6.4.3",
    "karma-chrome-launcher": "^3.1.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "ng-packagr": "22.2.6",
    "postcss-rtlcss": "^6.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "author": "北京商典信息科技有限公司 (Beijing Shangdian Information Technology Co., Ltd.)"
}
